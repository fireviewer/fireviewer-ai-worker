FROM pytorch/pytorch@sha256:8d409f72f99e5968b5c4c9396a21f4b723982cfdf2c1a5b9cc045c5d0a7345a1

ARG UBUNTU_SECURITY_REFRESH=2026-08-23

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SM_MODEL_DIR=/opt/ml/model \
    FW_PRITHVI_TILE_BATCH_SIZE=1

WORKDIR /opt/fireviewer

RUN test -n "${UBUNTU_SECURITY_REFRESH}" \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && DEBIAN_FRONTEND=noninteractive apt-get purge -y --auto-remove linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/aws-sagemaker-geo/requirements.txt /tmp/fireviewer-geo-requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/fireviewer-geo-requirements.txt \
    && rm /tmp/fireviewer-geo-requirements.txt

COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --no-deps . \
    && python -m pip check \
    && python -m pip uninstall -y pip setuptools wheel

EXPOSE 8080

ENTRYPOINT ["python", "-m", "firewarning_worker.mvp.gpu.sagemaker_service"]
