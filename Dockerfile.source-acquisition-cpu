FROM python:3.12-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080

WORKDIR /opt/firewarning-worker
COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install .[source-acquisition] \
    && groupadd --gid 10001 fireviewer \
    && useradd --create-home --uid 10001 --gid fireviewer worker

USER worker
EXPOSE 8080

ENTRYPOINT ["python", "-m", "firewarning_worker.mvp.research.source_acquisition_service"]
