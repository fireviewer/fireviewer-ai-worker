FROM python:3.12-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/firewarning-worker
COPY pyproject.toml README.md ./
RUN python -m pip install \
        azure-identity==1.25.3 \
        httpx==0.28.1 \
        numpy==2.4.6 \
        pydantic==2.13.4 \
        pyproj==3.7.2

COPY src ./src
RUN python -m pip install --no-deps . \
    && python -c "import numpy, pyproj; from azure.identity import ManagedIdentityCredential; print(numpy.__version__, pyproj.__version__, ManagedIdentityCredential.__name__)"

RUN groupadd --gid 10001 fireviewer \
    && useradd --create-home --uid 10001 --gid fireviewer worker

USER worker
EXPOSE 8080

ENTRYPOINT ["python", "-m", "firewarning_worker.mvp.localization.geographic_cpu_service"]
