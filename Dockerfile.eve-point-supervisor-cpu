FROM node:24-bookworm-slim AS node-runtime

FROM python:3.12-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080 \
    FIREVIEWER_SUPERVISION_PORT=8091 \
    FIREVIEWER_EVE_ROOT=/opt/eve-point-supervisor

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

WORKDIR /opt/firewarning-worker
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install .[source-acquisition]

WORKDIR /opt/eve-point-supervisor
COPY eve-point-supervisor/package.json eve-point-supervisor/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY eve-point-supervisor/agent ./agent
COPY eve-point-supervisor/tsconfig.json ./
RUN npm run build \
    && npm cache clean --force \
    && groupadd --gid 10001 fireviewer \
    && useradd --create-home --uid 10001 --gid fireviewer worker \
    && chown -R worker:fireviewer /opt/eve-point-supervisor

USER worker
EXPOSE 8080

ENTRYPOINT ["python", "-m", "firewarning_worker.mvp.supervision.eve_cpu_runtime"]
